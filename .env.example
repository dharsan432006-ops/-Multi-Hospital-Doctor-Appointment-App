# --- LOCAL DEVELOPMENT ONLY. NEVER use these values in production. ---
# --- Copy to .env for local dev: cp .env.example .env ---
# PRODUCTION: generate fresh secrets (JWT_* >=32 random bytes, ENCRYPTION_KEY =
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`,
# strong POSTGRES_PASSWORD + SEED_* passwords) via AWS Secrets Manager / Helm
# secrets. The values below are publicly-known dev placeholders and MUST be
# rotated if ever used outside local development.
# Timezone (display IST, store UTC)
TZ=Asia/Kolkata

# --- Postgres ---
POSTGRES_USER=appoint
POSTGRES_PASSWORD=appoint_dev_password_change_me
POSTGRES_DB=appointments
# Used by Prisma + API on host (docker-compose overrides this inside the api container)
DATABASE_URL=postgresql://appoint:appoint_dev_password_change_me@localhost:5432/appointments?schema=public
# Used on host machine (outside docker) for migrate/seed (same as above)
DATABASE_URL_HOST=postgresql://appoint:appoint_dev_password_change_me@localhost:5432/appointments?schema=public

# --- Redis (BullMQ) — host default is localhost; docker-compose overrides to redis://redis:6379 inside containers ---
REDIS_URL=redis://localhost:6379
REDIS_URL_HOST=redis://localhost:6379

# --- API ---
API_PORT=4000
JWT_ACCESS_SECRET=change_me_32_chars_min_access_secret_123456
JWT_REFRESH_SECRET=change_me_32_chars_min_refresh_secret_654321
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# CORS allow-list (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# App-level AES-256-GCM key for medicalNotesEnc (32 bytes, base64). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Previous key for rotation (optional)
PREV_ENCRYPTION_KEY=

# Cancellation cut-off in hours
CANCELLATION_CUTOFF_HOURS=2

# --- Seed demo passwords (NEVER commit real .env; these are dev-only examples) ---
SEED_ADMIN_PASSWORD=Admin123!ChangeMe
SEED_DOCTOR_PASSWORD=Doctor123!ChangeMe
SEED_PATIENT_PASSWORD=Patient123!ChangeMe

# --- Notifications (console provider is default for dev/test) ---
NOTIFICATION_PROVIDER=console
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@example.test
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+911800000000

# --- AI via OpenRouter (https://openrouter.ai) ---
# Get a key at openrouter.ai/keys. If empty, /api/ai/* returns 503 (feature disabled).
OPENROUTER_API_KEY=
# Default model (override per request is NOT allowed; server-pinned for safety/cost)
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Bangalore Hospital Appointments
AI_ENABLED=true
AI_MAX_INPUT_CHARS=1000

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:4000/api
